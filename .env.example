# Copy to .env and adjust values.

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=loananalytics

# Flask
FLASK_SECRET_KEY=change_me_secret
FLASK_ENV=development

# App
APP_ENV=development

# Model/Reports paths (relative to repo root)
MODEL_DIR=saved_models
REPORTS_DIR=reports
DATA_DIR=datasets

# Dataset generation
DATASET_MODE=synthetic
DATASET_ROWS=5000

