# --- Database Configuration ---
# You can specify the full DATABASE_URL directly:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/loananalytics
# Or supply discrete parameters (FastAPI will build the URL or fall back to SQLite):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=loananalytics

# --- Authentication ---
JWT_SECRET=super-secret-key-change-in-production
TOKEN_EXPIRY_SECONDS=36000

# --- ML Pipeline ---
DATASET_ROWS=5000
DATASET_MODE=synthetic # Set to 'synthetic' for generator

# --- Server ---
PORT=5000
